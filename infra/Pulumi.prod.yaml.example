config:
  # Required — Cloudflare account id (Overview in dashboard)
  ctf-cloudflare:accountId: REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
  ctf-cloudflare:workerName: challenge-the-footage
  ctf-cloudflare:domain: challengethefootage.com
  ctf-cloudflare:enableR2: "true"
  # Phase 2 (after first wrangler deploy):
  # ctf-cloudflare:zoneId: REPLACE_WITH_ZONE_ID
  # ctf-cloudflare:enableRoutes: "true"
