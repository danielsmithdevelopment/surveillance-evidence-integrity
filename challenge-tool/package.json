{
  "name": "challenge-the-footage",
  "version": "1.0.0",
  "private": true,
  "description": "challengethefootage.com — FRE 901 / 702 / 4th Amendment / §1983 document generator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "test:a11y": "npm run build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "npm run build && node test/lighthouse-runner.mjs",
    "lighthouse:lhci": "npm run build && lhci autorun",
    "ci": "npm run format:check && npm run lint && npm test && npm run test:a11y && npm run lighthouse"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "lighthouse": "^12.8.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5",
    "wrangler": "^4.20.0"
  }
}
